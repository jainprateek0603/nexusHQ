# Runtime
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL. Docker Compose publishes Postgres on port 54329.
DATABASE_URL=postgresql://nexushq:nexushq@localhost:54329/nexushq?schema=public

# Redis. Leave empty to run the API as a single node with inline mail and in-process realtime.
REDIS_URL=redis://localhost:63799

# Auth. Use a unique value of at least 32 characters. Required in every environment.
AUTH_SECRET=replace-with-a-random-string-at-least-32-chars

# Origins
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
API_PORT=4000
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000

# Google OAuth. Leave blank to disable the button; the routes return GOOGLE_NOT_CONFIGURED.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/v1/auth/google/callback

# AI. mock is the default and is used by tests. openai and anthropic fail startup without a key.
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-5
EMBEDDING_PROVIDER=mock

# Stripe test mode. Leave blank to keep organizations on the Free plan.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# Mail. Leave SMTP_URL blank to write .eml files into MAIL_DIR.
SMTP_URL=
MAIL_FROM=NexusHQ <no-reply@nexushq.local>
MAIL_DIR=var/mail

# Files and observability
UPLOAD_DIR=var/uploads
SENTRY_DSN=
