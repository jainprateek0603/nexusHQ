generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String?
  avatarUrl       String?
  emailVerified   DateTime?
  totpSecret      String?
  totpEnabled     Boolean   @default(false)
  totpLastStep    Int?
  isPlatformAdmin Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions               Session[]
  oauthAccounts          OAuthAccount[]
  backupCodes            TotpBackupCode[]
  mfaChallenges          MfaChallenge[]
  memberships            Membership[]
  invitationsSent        Invitation[]          @relation("Inviter")
  messages               Message[]             @relation("MessageAuthor")
  docComments            DocComment[]          @relation("DocCommentAuthor")
  taskComments           TaskComment[]         @relation("TaskCommentAuthor")
  reactions              Reaction[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  channelMembers         ChannelMember[]
  assignedTasks          Task[]                @relation("Assignee")
  createdTasks           Task[]                @relation("TaskCreator")
  attachments            Attachment[]          @relation("AttachmentUploader")
  apiKeys                ApiKey[]              @relation("ApiKeyCreator")
  projects               Project[]             @relation("ProjectCreator")
  documents              Document[]            @relation("DocCreator")
  documentVersions       DocumentVersion[]     @relation("VersionCreator")
  channels               Channel[]             @relation("ChannelCreator")
  webhooks               WebhookEndpoint[]     @relation("WebhookCreator")
  grants                 ResourceGrant[]
  aiUsage                AiUsage[]
  mentions               Mention[]
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  familyId         String
  expiresAt        DateTime
  userAgent        String?
  ip               String?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model TotpBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MfaChallenge {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organization {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique
  plan                 String    @default("FREE")
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String    @default("none")
  currentPeriodEnd     DateTime?
  aiRequestsUsed       Int       @default(0)
  aiPeriodStart        DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  memberships     Membership[]
  invitations     Invitation[]
  grants          ResourceGrant[]
  projects        Project[]
  documents       Document[]
  channels        Channel[]
  notifications   Notification[]
  activities      ActivityEvent[]
  auditLogs       AuditLog[]
  apiKeys         ApiKey[]
  webhooks        WebhookEndpoint[]
  deliveries      WebhookDelivery[]
  embeddings      EmbeddingChunk[]
  aiUsage         AiUsage[]
  searchDocuments SearchDocument[]
  attachments     Attachment[]
  tasks           Task[]
  labels          Label[]
  sprints         Sprint[]
  taskLabels      TaskLabel[]
  dependencies    TaskDependency[]
  taskComments    TaskComment[]
  docComments     DocComment[]
  mentions        Mention[]
  messages        Message[]
  reactions       Reaction[]
  versions        DocumentVersion[]
  channelMembers  ChannelMember[]
}

model Membership {
  id        String       @id @default(cuid())
  orgId     String
  userId    String
  role      String
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@index([orgId, role])
}

model Invitation {
  id         String       @id @default(cuid())
  orgId      String
  email      String
  role       String
  tokenHash  String       @unique
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  inviter    User         @relation("Inviter", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([orgId, email])
}

model ResourceGrant {
  id           String       @id @default(cuid())
  orgId        String
  userId       String
  resourceType String
  resourceId   String
  createdAt    DateTime     @default(now())
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceType, resourceId])
  @@index([orgId, resourceType, resourceId])
}

model Project {
  id          String       @id @default(cuid())
  orgId       String
  name        String
  key         String
  description String       @default("")
  status      String       @default("ACTIVE")
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tasks       Task[]
  sprints     Sprint[]
  labels      Label[]

  @@unique([orgId, key])
  @@index([orgId, status])
}

model Sprint {
  id        String       @id @default(cuid())
  orgId     String
  projectId String
  name      String
  goal      String       @default("")
  startDate DateTime
  endDate   DateTime
  status    String       @default("PLANNED")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([projectId, status])
  @@index([orgId])
}

model Label {
  id        String       @id @default(cuid())
  orgId     String
  projectId String
  name      String
  color     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  @@unique([projectId, name])
  @@index([orgId])
}

model Task {
  id          String       @id @default(cuid())
  orgId       String
  projectId   String
  parentId    String?
  sprintId    String?
  assigneeId  String?
  createdById String
  title       String
  description String       @default("")
  status      String       @default("TODO")
  priority    String       @default("MEDIUM")
  dueDate     DateTime?
  position    Float        @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent      Task?        @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  children    Task[]       @relation("Subtasks")
  sprint      Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  assignee    User?        @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  labels      TaskLabel[]
  blockedBy   TaskDependency[] @relation("Dependent")
  blocking    TaskDependency[] @relation("Dependency")
  comments    TaskComment[]

  @@index([orgId, projectId, status, position])
  @@index([orgId, assigneeId])
  @@index([orgId, dueDate])
  @@index([parentId])
  @@index([sprintId])
  @@index([projectId])
}

model TaskLabel {
  orgId   String
  taskId  String
  labelId String
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task    Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   Label        @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
  @@index([orgId])
}

model TaskDependency {
  orgId       String
  taskId      String
  dependsOnId String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task        Task         @relation("Dependent", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   Task         @relation("Dependency", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
  @@index([dependsOnId])
  @@index([orgId])
}

model TaskComment {
  id        String       @id @default(cuid())
  orgId     String
  taskId    String
  authorId  String
  body      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task      Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User         @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([orgId])
}

model Document {
  id          String       @id @default(cuid())
  orgId       String
  parentId    String?
  title       String
  icon        String?
  position    Float        @default(0)
  plainText   String       @default("")
  yjsState    Bytes?
  createdById String
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent      Document?    @relation("DocTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Document[]   @relation("DocTree")
  createdBy   User         @relation("DocCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions    DocumentVersion[]
  comments    DocComment[]
  attachments Attachment[]

  @@index([orgId, parentId, position])
  @@index([orgId, updatedAt])
}

model DocumentVersion {
  id          String   @id @default(cuid())
  orgId       String
  documentId  String
  title       String
  plainText   String
  yjsState    Bytes
  createdById String
  createdAt   DateTime @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  document    Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("VersionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([documentId, createdAt])
  @@index([orgId])
}

model DocComment {
  id         String       @id @default(cuid())
  orgId      String
  documentId String
  authorId   String
  parentId   String?
  body       String
  anchorText String?
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  document   Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author     User         @relation("DocCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  parent     DocComment?  @relation("DocCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    DocComment[] @relation("DocCommentThread")

  @@index([documentId, createdAt])
  @@index([orgId])
}

model Mention {
  id         String       @id @default(cuid())
  orgId      String
  userId     String
  sourceType String
  sourceId   String
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([orgId, sourceType, sourceId])
}

model Channel {
  id          String       @id @default(cuid())
  orgId       String
  name        String
  description String       @default("")
  type        String       @default("PUBLIC")
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("ChannelCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members     ChannelMember[]
  messages    Message[]

  @@index([orgId, type])
}

model ChannelMember {
  channelId  String
  userId     String
  orgId      String
  lastReadAt DateTime     @default(now())
  joinedAt   DateTime     @default(now())
  channel    Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId, orgId])
}

model Message {
  id        String    @id @default(cuid())
  orgId     String
  channelId String
  authorId  String
  parentId  String?
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channel   Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author    User         @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  parent    Message?     @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Message[]    @relation("Thread")
  reactions Reaction[]
  attachments Attachment[]

  @@index([channelId, createdAt])
  @@index([parentId, createdAt])
  @@index([orgId, createdAt])
}

model Reaction {
  id        String   @id @default(cuid())
  orgId     String
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  message   Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([orgId])
}

model Attachment {
  id         String    @id @default(cuid())
  orgId      String
  messageId  String?
  documentId String?
  uploadedBy String
  filename   String
  mimeType   String
  size       Int
  storageKey String
  createdAt  DateTime  @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  message    Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  document   Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  uploader   User         @relation("AttachmentUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([messageId])
  @@index([orgId])
  @@index([documentId])
}

model Notification {
  id        String    @id @default(cuid())
  orgId     String
  userId    String
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime  @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([orgId])
}

model NotificationPreference {
  userId        String  @id
  emailDigest   String  @default("DAILY")
  inApp         Boolean @default(true)
  emailMentions Boolean @default(true)
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityEvent {
  id         String       @id @default(cuid())
  orgId      String
  actorId    String?
  action     String
  entityType String
  entityId   String
  summary    String
  metadata   Json
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([entityType, entityId])
}

model AuditLog {
  id         String       @id @default(cuid())
  orgId      String
  actorId    String?
  action     String
  entityType String
  entityId   String
  ip         String?
  userAgent  String?
  metadata   Json
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([actorId])
}

model ApiKey {
  id         String    @id @default(cuid())
  orgId      String
  name       String
  prefix     String
  hash       String    @unique
  scopes     Json
  createdBy  String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator    User         @relation("ApiKeyCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([orgId])
}

model WebhookEndpoint {
  id        String       @id @default(cuid())
  orgId     String
  url       String
  secret    String
  events    Json
  enabled   Boolean      @default(true)
  createdBy String
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator   User         @relation("WebhookCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  deliveries WebhookDelivery[]

  @@index([orgId])
}

model WebhookDelivery {
  id          String           @id @default(cuid())
  orgId       String
  endpointId  String
  event       String
  payload     Json
  status      String           @default("PENDING")
  attempts    Int              @default(0)
  nextRetryAt DateTime?
  lastError   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  endpoint    WebhookEndpoint  @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([endpointId])
  @@index([orgId])
}

model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

model FeatureFlag {
  key          String   @id
  description  String
  enabled      Boolean  @default(false)
  orgAllowlist Json
  updatedAt    DateTime @updatedAt
}

model EmbeddingChunk {
  id         String       @id @default(cuid())
  orgId      String
  sourceType String
  sourceId   String
  chunkIndex Int
  content    String
  embedding  Json
  updatedAt  DateTime     @updatedAt
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId, chunkIndex])
  @@index([orgId, sourceType])
}

model AiUsage {
  id        String       @id @default(cuid())
  orgId     String
  userId    String
  action    String
  tokensIn  Int
  tokensOut Int
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([userId])
}

model SearchDocument {
  id         String       @id @default(cuid())
  orgId      String
  sourceType String
  sourceId   String
  title      String
  body       String
  updatedAt  DateTime     @updatedAt
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId])
  @@index([orgId, sourceType])
}
